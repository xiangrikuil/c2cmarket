# Staging environment template for C2CMarket.
# Copy this file to .env.staging and replace every CHANGE_ME value before use.

POSTGRES_DB=c2c_market_staging
POSTGRES_USER=c2c_market_staging
POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_STAGING_DATABASE_PASSWORD
POSTGRES_PORT=5433

BACKEND_PORT=8081
BACKEND_IMAGE=c2cmarket-backend:CHANGE_ME_STAGING_RELEASE_VERSION
APP_ENV=production
ENABLE_DEV_AUTH=false
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30s
DB_SLOW_QUERY_THRESHOLD=1s
METRICS_BEARER_TOKEN=CHANGE_ME_DISTINCT_STAGING_32_BYTE_MINIMUM_METRICS_TOKEN
FRONTEND_ORIGIN=https://staging.c2cmarket.shop
ALLOWED_ORIGINS=https://staging.c2cmarket.shop
# Observe the backend container's immediate Tunnel peer before replacing this value.
TRUST_X_FORWARDED_FOR=true
TRUSTED_PROXIES=CHANGE_ME_OBSERVED_IMMEDIATE_PEER_IP_OR_CIDR
# Comma-separated exact provider hosts. Empty permits any public HTTPS host.
MODEL_AUDIT_ALLOWED_HOSTS=

OAUTH_PROVIDER_MODE=oauth2
OAUTH_CLIENT_ID=CHANGE_ME_STAGING_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=CHANGE_ME_STAGING_OAUTH_CLIENT_SECRET
OAUTH_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
OAUTH_TOKEN_URL=https://connect.linuxdo.org/oauth2/token
OAUTH_USERINFO_URL=https://connect.linuxdo.org/api/user
OAUTH_REDIRECT_URL=https://api-staging.c2cmarket.shop/api/v1/auth/oauth/callback
OAUTH_SCOPES=openid profile

CONTACT_KEY_VERSION=staging-v1
# Keyrings are the rotating staging source of truth. Keep old versions until
# contact-reencrypt --apply reports no records on them.
CONTACT_ENCRYPTION_KEYRING={"staging-v1":"CHANGE_ME_DIFFERENT_STAGING_32_BYTE_MINIMUM_SECRET"}
CONTACT_FINGERPRINT_KEYRING={"staging-v1":"CHANGE_ME_DIFFERENT_STAGING_32_BYTE_MINIMUM_SECRET"}
# Legacy single-key compatibility for deployments that are not rotating yet.
CONTACT_ENCRYPTION_KEY=
CONTACT_FINGERPRINT_KEY=
EMAIL_VERIFICATION_PEPPER=CHANGE_ME_DIFFERENT_STAGING_32_BYTE_MINIMUM_SECRET
MAINTENANCE_INTERVAL=15m
MAINTENANCE_BATCH_SIZE=500
SESSION_RETENTION=168h
EMAIL_VERIFICATION_RETENTION=24h
READ_NOTIFICATION_RETENTION=2160h
UNREAD_NOTIFICATION_RETENTION=8760h
DOMAIN_EVENT_RETENTION=8760h
API_DELIVERY_CREDENTIAL_RETENTION=720h
API_HEALTH_RUNNER_ENABLED=true
API_HEALTH_SCAN_INTERVAL=1m
API_HEALTH_PROBE_TIMEOUT=10s
API_HEALTH_MAX_CONCURRENCY=4
API_HEALTH_CLAIM_BATCH_SIZE=50
API_HEALTH_SAMPLE_RETENTION=168h
API_HEALTH_CHALLENGE_TTL=30m

# Empty-database first start only. Clear both values after successful Bootstrap.
# Existing deployments with an administrator must keep both values empty when upgrading.
C2C_BOOTSTRAP_ADMIN_USERNAME=admin
C2C_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME_STAGING_BOOTSTRAP_PASSWORD

EMAIL_PROVIDER=aliyun_directmail
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME_VERIFIED_DIRECTMAIL_ACCOUNT
SMTP_PASSWORD=CHANGE_ME_DIRECTMAIL_SMTP_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_VERIFIED_SENDER_ADDRESS
MAIL_FROM_NAME=C2CMarket Staging

NUXT_PUBLIC_API_MODE=real
NUXT_PUBLIC_SITE_URL=https://staging.c2cmarket.shop
NUXT_PUBLIC_API_BASE_URL=https://api-staging.c2cmarket.shop
NUXT_API_BASE_URL=https://api-staging.c2cmarket.shop
NUXT_PUBLIC_UMAMI_ENABLED=false
NUXT_PUBLIC_UMAMI_SCRIPT_URL=https://CHANGE_ME_UMAMI_DOMAIN/script.js
NUXT_PUBLIC_UMAMI_WEBSITE_ID=CHANGE_ME_UMAMI_WEBSITE_ID
NUXT_PUBLIC_UMAMI_DOMAINS=staging.c2cmarket.shop
NUXT_PUBLIC_UMAMI_HOST_URL=https://CHANGE_ME_UMAMI_DOMAIN
NUXT_PUBLIC_UMAMI_DEBUG=false
