POSTGRES_DB=c2c_market
POSTGRES_USER=c2c_market
POSTGRES_PASSWORD=c2c_market_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
BACKEND_IMAGE=c2cmarket-backend:local
APP_VERSION=development
GIT_COMMIT=unknown
BUILD_TIME=1970-01-01T00:00:00Z
APP_ENV=development
ENABLE_DEV_AUTH=true
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30s
DB_SLOW_QUERY_THRESHOLD=1s
METRICS_BEARER_TOKEN=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local development does not trust client-supplied forwarding headers.
TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXIES=
MODEL_AUDIT_ALLOWED_HOSTS=
OAUTH_PROVIDER_MODE=fake
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/oauth/callback
OAUTH_SCOPES=openid profile
CONTACT_ENCRYPTION_KEY=c2cmarket-local-contact-encryption-key-v1
CONTACT_FINGERPRINT_KEY=c2cmarket-local-contact-fingerprint-key-v1
CONTACT_KEY_VERSION=local-dev-v1
CONTACT_ENCRYPTION_KEYRING={"local-dev-v1":"c2cmarket-local-contact-encryption-key-v1"}
CONTACT_FINGERPRINT_KEYRING={"local-dev-v1":"c2cmarket-local-contact-fingerprint-key-v1"}
EMAIL_VERIFICATION_PEPPER=c2cmarket-local-email-verification-pepper-v1
MAINTENANCE_INTERVAL=15m
MAINTENANCE_BATCH_SIZE=500
SESSION_RETENTION=168h
EMAIL_VERIFICATION_RETENTION=24h
READ_NOTIFICATION_RETENTION=2160h
UNREAD_NOTIFICATION_RETENTION=8760h
DOMAIN_EVENT_RETENTION=8760h
API_DELIVERY_CREDENTIAL_RETENTION=720h
API_HEALTH_RUNNER_ENABLED=true
API_HEALTH_SCAN_INTERVAL=1m
API_HEALTH_PROBE_TIMEOUT=30s
API_HEALTH_MAX_CONCURRENCY=4
API_HEALTH_CLAIM_BATCH_SIZE=50
API_HEALTH_SAMPLE_RETENTION=192h
# Local Compose uses the bundled MinIO service. Production should use a private S3/R2 bucket.
EVIDENCE_ENABLED=true
EVIDENCE_S3_ENDPOINT=http://127.0.0.1:9000
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_BUCKET=c2cmarket-evidence
EVIDENCE_S3_ACCESS_KEY=c2cmarket-minio
EVIDENCE_S3_SECRET_KEY=c2cmarket-minio-dev-password
EVIDENCE_S3_PATH_STYLE=true
C2C_BOOTSTRAP_ADMIN_USERNAME=
C2C_BOOTSTRAP_ADMIN_PASSWORD=
EMAIL_PROVIDER=development
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=C2CMarket
NUXT_PUBLIC_API_MODE=real
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:5173
NUXT_PUBLIC_API_BASE_URL=
