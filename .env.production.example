# Production environment template for C2CMarket.
# Copy this file to .env.production and replace every CHANGE_ME value before use.

POSTGRES_DB=c2c_market
POSTGRES_USER=c2c_market
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_PORT=5432

BACKEND_PORT=8080
BACKEND_IMAGE=c2cmarket-backend:CHANGE_ME_RELEASE_VERSION
APP_ENV=production
ENABLE_DEV_AUTH=false
SENTRY_ENABLED=true
SENTRY_DSN=https://90dd1e33a789a0935b8d8ca4ef2ab319@o4511896757010432.ingest.us.sentry.io/4511896765726720
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30s
DB_SLOW_QUERY_THRESHOLD=1s
METRICS_BEARER_TOKEN=CHANGE_ME_DISTINCT_32_BYTE_MINIMUM_METRICS_TOKEN
TURNSTILE_SECRET=CHANGE_ME_CLOUDFLARE_TURNSTILE_WIDGET_SECRET
TURNSTILE_HOSTNAMES=c2cmarket.shop
FRONTEND_ORIGIN=https://c2cmarket.shop
ALLOWED_ORIGINS=https://c2cmarket.shop
# Observe the backend container's immediate Tunnel peer before replacing this value.
TRUST_X_FORWARDED_FOR=true
TRUSTED_PROXIES=CHANGE_ME_OBSERVED_IMMEDIATE_PEER_IP_OR_CIDR
# Comma-separated exact provider hosts. Empty permits any public HTTPS host.
MODEL_AUDIT_ALLOWED_HOSTS=

OAUTH_PROVIDER_MODE=oauth2
OAUTH_CLIENT_ID=CHANGE_ME_PRODUCTION_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=CHANGE_ME_PRODUCTION_OAUTH_CLIENT_SECRET
OAUTH_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
OAUTH_TOKEN_URL=https://connect.linuxdo.org/oauth2/token
OAUTH_USERINFO_URL=https://connect.linuxdo.org/api/user
OAUTH_REDIRECT_URL=https://api.c2cmarket.shop/api/v1/auth/oauth/callback
OAUTH_SCOPES=openid profile

CONTACT_KEY_VERSION=prod-v1
# Keyrings are the rotating production source of truth. Keep old versions until
# contact-reencrypt --apply reports no records on them.
CONTACT_ENCRYPTION_KEYRING={"prod-v1":"CHANGE_ME_32_BYTE_MINIMUM_SECRET"}
CONTACT_FINGERPRINT_KEYRING={"prod-v1":"CHANGE_ME_DIFFERENT_32_BYTE_MINIMUM_SECRET"}
# Legacy single-key compatibility for deployments that are not rotating yet.
CONTACT_ENCRYPTION_KEY=
CONTACT_FINGERPRINT_KEY=
EMAIL_VERIFICATION_PEPPER=CHANGE_ME_DIFFERENT_32_BYTE_MINIMUM_SECRET
MAINTENANCE_INTERVAL=15m
MAINTENANCE_BATCH_SIZE=500
SESSION_RETENTION=168h
EMAIL_VERIFICATION_RETENTION=24h
READ_NOTIFICATION_RETENTION=2160h
UNREAD_NOTIFICATION_RETENTION=8760h
DOMAIN_EVENT_RETENTION=8760h
API_DELIVERY_CREDENTIAL_RETENTION=720h
API_HEALTH_RUNNER_ENABLED=true
API_HEALTH_SCAN_INTERVAL=1m
API_HEALTH_PROBE_TIMEOUT=30s
API_HEALTH_MAX_CONCURRENCY=4
API_HEALTH_CLAIM_BATCH_SIZE=50
API_HEALTH_SAMPLE_RETENTION=192h

# Empty-database first start only. Clear both values after successful Bootstrap.
# Existing deployments with an administrator must keep both values empty when upgrading.
C2C_BOOTSTRAP_ADMIN_USERNAME=admin
C2C_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME_BOOTSTRAP_PASSWORD

EMAIL_PROVIDER=aliyun_directmail
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME_VERIFIED_DIRECTMAIL_ACCOUNT
SMTP_PASSWORD=CHANGE_ME_DIRECTMAIL_SMTP_PASSWORD
MAIL_FROM_ADDRESS=CHANGE_ME_VERIFIED_SENDER_ADDRESS
MAIL_FROM_NAME=C2CMarket

NUXT_PUBLIC_API_MODE=real
NUXT_PUBLIC_SITE_URL=https://c2cmarket.shop
NUXT_PUBLIC_API_BASE_URL=https://api.c2cmarket.shop
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAENOJxBZnePMzh-y
NUXT_API_BASE_URL=https://api.c2cmarket.shop
NUXT_PUBLIC_SENTRY_ENABLED=true
NUXT_PUBLIC_SENTRY_DSN=https://8901ac14cbe915a42461dee50b7bc987@o4511896757010432.ingest.us.sentry.io/4511896760287232
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_UMAMI_ENABLED=true
NUXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NUXT_PUBLIC_UMAMI_WEBSITE_ID=110bd0c9-6337-462d-af58-02330b258307
NUXT_PUBLIC_UMAMI_DOMAINS=c2cmarket.shop
NUXT_PUBLIC_UMAMI_HOST_URL=
NUXT_PUBLIC_UMAMI_DEBUG=false
